<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Debug builds expose GameActivity so automated emulator smoke tests can
         launch a level / the daily challenge directly via `adb am start`.
         Release builds keep it un-exported. -->
    <application>
        <activity
            android:name=".ui.GameActivity"
            android:exported="true"
            tools:node="merge" />
    </application>

</manifest>
